<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sty="using:FluentAvalonia.Styling"
             x:Class="WNS3Connect.App"
             RequestedThemeVariant="Light">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://WNS3Connect/Themes/Theme.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <!-- Giao diện Windows 11 (WinUI): font Segoe UI Variable, màu nhấn theo Windows -->
    <sty:FluentAvaloniaTheme PreferSystemTheme="False" PreferUserAccentColor="True" UseSystemFontOnWindows="True" />
    <StyleInclude Source="avares://WNS3Connect/Themes/Styles.axaml" />
  </Application.Styles>
</Application>
