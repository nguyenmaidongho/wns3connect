<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>

    <!-- Dark: tông VS Code như bản WPF -->
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="ThemeWindowBackground" Color="#1E1E1E" />
      <SolidColorBrush x:Key="ThemeToolbarBackground" Color="#252526" />
      <SolidColorBrush x:Key="ThemeSidebarBackground" Color="#252526" />
      <SolidColorBrush x:Key="ThemeBorderBrush" Color="#3C3C3C" />
      <SolidColorBrush x:Key="ThemeForeground" Color="#DCDCDC" />
      <SolidColorBrush x:Key="ThemeForegroundMuted" Color="#A0A0A0" />
      <SolidColorBrush x:Key="ThemeInputBackground" Color="#2D2D30" />
      <SolidColorBrush x:Key="ThemeButtonBackground" Color="#2D3139" />
      <SolidColorBrush x:Key="ThemeButtonHover" Color="#3A3F4B" />
      <SolidColorBrush x:Key="ThemeButtonHoverBorder" Color="#61AFEF" />
      <SolidColorBrush x:Key="ThemeButtonHoverForeground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ThemeItemHover" Color="#094771" />
      <SolidColorBrush x:Key="ThemeItemSelected" Color="#0E639C" />
      <SolidColorBrush x:Key="ThemeStatusBackground" Color="#1E1E1E" />
      <SolidColorBrush x:Key="ThemeCardBackground" Color="#252526" />
      <SolidColorBrush x:Key="ThemePopupBackground" Color="#252526" />
      <SolidColorBrush x:Key="ThemeScrollBarThumb" Color="#555555" />
      <SolidColorBrush x:Key="ThemeScrollBarThumbHover" Color="#737373" />
      <SolidColorBrush x:Key="ThemeConnectButtonBackground" Color="#0E639C" />
      <SolidColorBrush x:Key="ThemeConnectButtonForeground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ThemeConnectButtonBorder" Color="#1177BB" />
      <SolidColorBrush x:Key="ThemeConnectButtonHoverBackground" Color="#1177BB" />
      <SolidColorBrush x:Key="ThemeConnectButtonHoverBorder" Color="#2896E0" />
      <SolidColorBrush x:Key="ThemeConnectButtonActiveBackground" Color="#0B4F7D" />
      <SolidColorBrush x:Key="ThemeTabSelectedBackground" Color="#1E1E1E" />
      <SolidColorBrush x:Key="ThemeTabUnselectedBackground" Color="#2D2D30" />
      <SolidColorBrush x:Key="ThemeTabSelectedForeground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ThemeTabUnselectedForeground" Color="#AAAAAA" />
      <!-- Dải tab terminal + vùng terminal luôn tối -->
      <SolidColorBrush x:Key="ThemeTabStripBackground" Color="#2B2D30" />
      <SolidColorBrush x:Key="ThemeTerminalBackground" Color="#1E1E1E" />
      <SolidColorBrush x:Key="ThemeChipActiveBackground" Color="#33C42030" />
      <SolidColorBrush x:Key="ThemeChipActiveBorder" Color="#88C42030" />
      <SolidColorBrush x:Key="ThemeDangerBrush" Color="#F85149" />
      <SolidColorBrush x:Key="ThemeOverlayBrush" Color="#A0000000" />
      <!-- WNS3Connect -->
      <SolidColorBrush x:Key="UiAppBg" Color="#202020" />
      <SolidColorBrush x:Key="UiSurface" Color="#2B2B2B" />
      <SolidColorBrush x:Key="UiSidebar" Color="#202020" />
      <SolidColorBrush x:Key="UiLine" Color="#3A3A3A" />
      <SolidColorBrush x:Key="UiRowHover" Color="#333333" />
      <SolidColorBrush x:Key="UiRowSelected" Color="#2F3A47" />
      <SolidColorBrush x:Key="UiAccent" Color="#4C8DF6" />
      <SolidColorBrush x:Key="UiAccentHover" Color="#6AA1F8" />
      <SolidColorBrush x:Key="UiAccentSoft" Color="#2F3A47" />
      <SolidColorBrush x:Key="UiAccentText" Color="#FFFFFF" />
      <SolidColorBrush x:Key="UiText" Color="#FFFFFF" />
      <SolidColorBrush x:Key="UiTextMuted" Color="#C5C5C5" />
      <SolidColorBrush x:Key="UiHeaderBg" Color="#2B2B2B" />
      <SolidColorBrush x:Key="UiChipBg" Color="#383838" />
    </ResourceDictionary>

    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="ThemeWindowBackground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ThemeToolbarBackground" Color="#F8F9FA" />
      <SolidColorBrush x:Key="ThemeSidebarBackground" Color="#FAFAFA" />
      <SolidColorBrush x:Key="ThemeBorderBrush" Color="#D0D5DD" />
      <SolidColorBrush x:Key="ThemeForeground" Color="#101828" />
      <SolidColorBrush x:Key="ThemeForegroundMuted" Color="#667085" />
      <SolidColorBrush x:Key="ThemeInputBackground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ThemeButtonBackground" Color="#F2F4F7" />
      <SolidColorBrush x:Key="ThemeButtonHover" Color="#E4E7EC" />
      <SolidColorBrush x:Key="ThemeButtonHoverBorder" Color="#98A2B3" />
      <SolidColorBrush x:Key="ThemeButtonHoverForeground" Color="#101828" />
      <SolidColorBrush x:Key="ThemeItemHover" Color="#EBF3FF" />
      <SolidColorBrush x:Key="ThemeItemSelected" Color="#D1E9FF" />
      <SolidColorBrush x:Key="ThemeStatusBackground" Color="#F2F4F7" />
      <SolidColorBrush x:Key="ThemeCardBackground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ThemePopupBackground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ThemeScrollBarThumb" Color="#C1C1C1" />
      <SolidColorBrush x:Key="ThemeScrollBarThumbHover" Color="#A8A8A8" />
      <SolidColorBrush x:Key="ThemeConnectButtonBackground" Color="#1570EF" />
      <SolidColorBrush x:Key="ThemeConnectButtonForeground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ThemeConnectButtonBorder" Color="#1570EF" />
      <SolidColorBrush x:Key="ThemeConnectButtonHoverBackground" Color="#175CD3" />
      <SolidColorBrush x:Key="ThemeConnectButtonHoverBorder" Color="#175CD3" />
      <SolidColorBrush x:Key="ThemeConnectButtonActiveBackground" Color="#1849A9" />
      <SolidColorBrush x:Key="ThemeTabSelectedBackground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ThemeTabUnselectedBackground" Color="#F2F4F7" />
      <SolidColorBrush x:Key="ThemeTabSelectedForeground" Color="#101828" />
      <SolidColorBrush x:Key="ThemeTabUnselectedForeground" Color="#667085" />
      <SolidColorBrush x:Key="ThemeTabStripBackground" Color="#2B2D30" />
      <SolidColorBrush x:Key="ThemeTerminalBackground" Color="#1E1E1E" />
      <SolidColorBrush x:Key="ThemeChipActiveBackground" Color="#33C42030" />
      <SolidColorBrush x:Key="ThemeChipActiveBorder" Color="#88C42030" />
      <SolidColorBrush x:Key="ThemeDangerBrush" Color="#D92D20" />
      <SolidColorBrush x:Key="ThemeOverlayBrush" Color="#80000000" />
      <!-- WNS3Connect -->
      <SolidColorBrush x:Key="UiAppBg" Color="#F3F3F3" />
      <SolidColorBrush x:Key="UiSurface" Color="#FFFFFF" />
      <SolidColorBrush x:Key="UiSidebar" Color="#F3F3F3" />
      <SolidColorBrush x:Key="UiLine" Color="#E5E5E5" />
      <SolidColorBrush x:Key="UiRowHover" Color="#F5F5F5" />
      <SolidColorBrush x:Key="UiRowSelected" Color="#E6F0FA" />
      <SolidColorBrush x:Key="UiAccent" Color="#1F6FEB" />
      <SolidColorBrush x:Key="UiAccentHover" Color="#175CD3" />
      <SolidColorBrush x:Key="UiAccentSoft" Color="#E6F0FA" />
      <SolidColorBrush x:Key="UiAccentText" Color="#FFFFFF" />
      <SolidColorBrush x:Key="UiText" Color="#1B1B1B" />
      <SolidColorBrush x:Key="UiTextMuted" Color="#616161" />
      <SolidColorBrush x:Key="UiHeaderBg" Color="#FFFFFF" />
      <SolidColorBrush x:Key="UiChipBg" Color="#EBEBEB" />
    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
