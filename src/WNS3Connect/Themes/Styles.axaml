    <StreamGeometry x:Key="IcSearch">M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z</StreamGeometry>
    <StreamGeometry x:Key="IcMore">M12,16A2,2 0 0,1 14,18A2,2 0 0,1 12,20A2,2 0 0,1 10,18A2,2 0 0,1 12,16M12,10A2,2 0 0,1 14,12A2,2 0 0,1 12,14A2,2 0 0,1 10,12A2,2 0 0,1 12,10M12,4A2,2 0 0,1 14,6A2,2 0 0,1 12,8A2,2 0 0,1 10,6A2,2 0 0,1 12,4Z</StreamGeometry>
    <StreamGeometry x:Key="IcChevron">M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z</StreamGeometry>
    <StreamGeometry x:Key="IcEdit">M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z</StreamGeometry>
    <StreamGeometry x:Key="IcTasks">M3,5H9V11H3V5M5,7V9H7V7H5M11,7H21V9H11V7M11,15H21V17H11V15M5,20L1.5,16.5L2.91,15.09L5,17.17L9.59,12.59L11,14L5,20Z</StreamGeometry>
    <StreamGeometry x:Key="IcMenu">M3,6H21V8H3V6M3,11H21V13H3V11M3,16H21V18H3V16Z</StreamGeometry>
    <x:Double x:Key="TreeViewItemIndent">12</x:Double>
    <StreamGeometry x:Key="IcEmpty">M20,6H12L10,4H4A2,2 0 0,0 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8A2,2 0 0,0 20,6M20,18H4V8H20V18Z</StreamGeometry>
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource UiAppBg}" />
    <Setter Property="Foreground" Value="{DynamicResource UiText}" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource UiTextMuted}" />
  </Style>
  <Style Selector="TextBlock.h">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.section">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource UiTextMuted}" />
    <Setter Property="LetterSpacing" Value="0.6" />
  </Style>

  <!-- Thẻ nội dung bo góc -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource UiSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource UiLine}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

  <!-- ===== Nút phẳng (ghost) ===== -->
  <Style Selector="Button.ghost, ToggleButton.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Foreground" Value="{DynamicResource UiText}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource UiRowHover}" />
    <Setter Property="Foreground" Value="{DynamicResource UiText}" />
  </Style>
  <Style Selector="Button.ghost:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource UiRowSelected}" />
  </Style>
  <Style Selector="Button.ghost:disabled /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.ghost:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.ghost:disabled, ToggleButton.ghost:disabled">
    <Setter Property="Opacity" Value="0.38" />
  </Style>
  <Style Selector="Button.ghost PathIcon, Button.accent PathIcon, Button.icon PathIcon">
    <Setter Property="Width" Value="15" />
    <Setter Property="Height" Value="15" />
  </Style>

  <!-- Nút chỉ có icon -->
  <Style Selector="Button.icon">
    <Setter Property="Padding" Value="7" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="MinWidth" Value="30" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>

  <!-- Viên thuốc tài khoản WebNow -->
  <Style Selector="Button.pill">
    <Setter Property="Background" Value="{DynamicResource UiChipBg}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="15" />
    <Setter Property="Padding" Value="12,5" />
    <Setter Property="MinHeight" Value="30" />
  </Style>
  <Style Selector="Button.pill:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource UiRowSelected}" />
  </Style>

  <!-- Chip lọc tác vụ -->
  <Style Selector="ToggleButton.chip">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="13" />
    <Setter Property="Padding" Value="11,3" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource UiTextMuted}" />
  </Style>
  <Style Selector="ToggleButton.chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource UiRowHover}" />
  </Style>
  <Style Selector="ToggleButton.chip:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource UiAccentSoft}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}" />
  </Style>

  <!-- Ô nhập -->
  <Style Selector="TextBox.search">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="30,5,8,5" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource UiAppBg}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <!-- ===== Sidebar (cây tài khoản → bucket) ===== -->
  <Style Selector="TreeView.nav">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="TreeView.nav TreeViewItem">
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Padding" Value="2,0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Margin" Value="0,1" />
  </Style>
  <Style Selector="TreeView.nav TreeViewItem /template/ Border#PART_LayoutRoot">
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="TreeView.nav TreeViewItem:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource UiRowHover}" />
  </Style>
  <Style Selector="TreeView.nav TreeViewItem:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Border.bucketRow">
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Padding" Value="6,3" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.bucketRow.current">
    <Setter Property="Background" Value="{DynamicResource UiAccentSoft}" />
  </Style>
  <Style Selector="Border.bucketRow.current TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Border.avatar">
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Background" Value="{DynamicResource UiChipBg}" />
  </Style>
  <Style Selector="Border.avatar.current">
    <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
  </Style>
  <Style Selector="Border.avatar TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource UiTextMuted}" />
  </Style>
  <Style Selector="Border.avatar.current TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
  </Style>

  <!-- ===== Bảng file ===== -->
  <Style Selector="ListBox.grid">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="4,2" />
  </Style>
  <Style Selector="ListBox.grid ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Margin" Value="0,0" />
  </Style>
  <Style Selector="TextBlock.cell">
    <Setter Property="Margin" Value="10,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style Selector="Button.header">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource UiTextMuted}" />
  </Style>
  <Style Selector="Button.header:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource UiRowHover}" />
    <Setter Property="Foreground" Value="{DynamicResource UiText}" />
  </Style>

  <!-- Breadcrumb -->
  <Style Selector="Button.crumb">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6,4" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Foreground" Value="{DynamicResource UiTextMuted}" />
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style Selector="Button.crumb.last">
    <Setter Property="Foreground" Value="{DynamicResource UiText}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.crumb:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource UiRowHover}" />
    <Setter Property="Foreground" Value="{DynamicResource UiText}" />
  </Style>

  <!-- Menu gọn -->
  <Style Selector="Menu.top">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Menu.top > MenuItem">
    <Setter Property="Padding" Value="9,5" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Foreground" Value="{DynamicResource UiTextMuted}" />
  </Style>

  <!-- Tab dưới -->
  <Style Selector="TabStrip TabStripItem">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="Margin" Value="0" />
  </Style>
  <Style Selector="TabControl.bottom TabItem">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="12,4" />
  </Style>

  <Style Selector="ProgressBar.thin">
    <Setter Property="Height" Value="2" />
    <Setter Property="MinHeight" Value="2" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}" />
  </Style>
  <Style Selector="ProgressBar.task">
    <Setter Property="Height" Value="6" />
    <Setter Property="MinHeight" Value="6" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Background" Value="{DynamicResource UiChipBg}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}" />
  </Style>

  <Style Selector="GridSplitter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
</Styles>
